---
import '../styles/global.css';
interface Props { title: string; description: string; image?: string }
const { title, description, image = '/og.png' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#14110c" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body class="min-h-dvh">
    <header class="mx-auto flex max-w-5xl items-center justify-between px-4 py-5">
      <a href="/" class="text-lg font-bold tracking-tight">riaal<span class="text-accent">.04</span></a>
      <nav class="flex gap-5 text-sm text-muted">
        <a class="hover:text-fg" href="/#apps">Apps</a>
        <a class="hover:text-fg" href="/#blog">Blog</a>
      </nav>
    </header>
    <main class="mx-auto max-w-5xl px-4 pb-24"><slot /></main>
    <footer class="border-t border-line py-8 text-center text-sm text-muted">
      © {new Date().getFullYear()} riaal.04 · Hecho con Astro
    </footer>
  </body>
</html>
