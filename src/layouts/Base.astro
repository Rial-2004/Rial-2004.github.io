---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
interface Props { title: string; description: string; image?: string; tema?: string }
const { title, description, image = '/og.png', tema } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
const path = Astro.url.pathname;
const tabs = [
  { href: '/', label: 'Sobre mí', active: path === '/' },
  { href: '/apps/', label: 'Apps', active: path.startsWith('/apps') },
];
---
<!doctype html>
<html lang="es" data-app={tema}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#eaf8ff" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      // Tema guardado o el del sistema, aplicado antes de pintar para evitar parpadeos
      (function () {
        var t = null;
        try { t = localStorage.getItem('theme'); } catch (e) {}
        if (t !== 'light' && t !== 'dark') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.setAttribute('data-theme', t);
      })();
    </script>
  </head>
  <body class="min-h-dvh">
    <header class="mx-auto flex max-w-5xl items-center justify-between gap-2 px-4 py-5">
      <a href="/" class="text-lg font-bold tracking-tight">riaal<span class="text-accent">.04</span></a>
      <div class="flex items-center gap-2">
        <nav class="flex gap-1 text-sm" aria-label="Principal">
          {tabs.map((t) => (
            <a href={t.href} aria-current={t.active ? 'page' : undefined}
               class:list={['rounded-full px-4 py-2 font-medium transition', t.active ? 'bg-accent text-on-accent shadow-md shadow-accent/30' : 'text-muted hover:text-fg']}>
              {t.label}
            </a>
          ))}
        </nav>
        <button id="theme-toggle" type="button" aria-label="Cambiar entre tema claro y oscuro" title="Cambiar tema"
          class="btn-outline grid h-10 w-10 place-items-center rounded-full text-lg">
          <span data-icon="moon"><Icon name="moon" class="h-5 w-5" /></span><span data-icon="sun" style="display:none"><Icon name="sun" class="h-5 w-5" /></span>
        </button>
      </div>
    </header>
    <main class="mx-auto max-w-5xl px-4 pb-24"><slot /></main>
    <footer class="border-t border-line py-8 text-center text-sm text-muted">
      <p>© {new Date().getFullYear()} riaal.04 · Hecho con Astro</p>
    </footer>
    <script is:inline>
      (function () {
        var root = document.documentElement, btn = document.getElementById('theme-toggle');
        function paint() {
          var dark = root.getAttribute('data-theme') === 'dark';
          btn.querySelector('[data-icon="moon"]').style.display = dark ? 'none' : '';
          btn.querySelector('[data-icon="sun"]').style.display = dark ? '' : 'none';
        }
        paint();
        btn.addEventListener('click', function () {
          var next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
          root.setAttribute('data-theme', next);
          try { localStorage.setItem('theme', next); } catch (e) {}
          paint();
        });
      })();
    </script>
    <script is:inline>
      document.querySelectorAll('.spotlight').forEach(function (el) {
        el.addEventListener('pointermove', function (e) {
          var r = el.getBoundingClientRect();
          el.style.setProperty('--mx', (e.clientX - r.left) + 'px');
          el.style.setProperty('--my', (e.clientY - r.top) + 'px');
        });
      });
    </script>
  </body>
</html>
