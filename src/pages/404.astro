---
import Base from '../layouts/Base.astro';
---
<Base title="Página no encontrada · riaal.04" description="Esta página no existe. Vuelve al inicio o a las apps.">
  <section class="py-20 sm:py-28">
    <p class="reveal text-sm font-medium uppercase tracking-widest text-accent">Error 404</p>
    <h1 class="reveal mt-4 text-5xl font-extrabold leading-[1.05] sm:text-7xl">Aquí no hay <span class="text-gradient">nada.</span></h1>
    <p class="reveal mt-6 max-w-xl text-lg text-muted">El enlace está roto o la página ya no existe. Lo que sí hay está a un toque.</p>
    <div class="reveal mt-8 flex flex-wrap gap-3">
      <a href="/" class="cta rounded-full px-6 py-3 font-semibold">Volver al inicio <span class="flecha" aria-hidden="true">→</span></a>
      <a href="/apps/" class="btn-outline inline-flex items-center rounded-full px-6 py-3 font-semibold">Ver las apps</a>
    </div>
  </section>
</Base>
