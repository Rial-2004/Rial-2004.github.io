---
import Base from '../layouts/Base.astro';
import { links } from '../data/links';
const enlaces = links.filter((l) => l.url || l.handle);
---
<Base title="riaal.04 · Sobre mí" description="Desarrollo apps Android a mano, las comparto para descargar y cuento lo que hago.">
  <section class="relative py-14 sm:py-24">
    <p class="reveal relative text-sm font-medium uppercase tracking-widest text-accent">Hola, soy Rial</p>
    <h1 class="reveal relative mt-4 text-[2.5rem] font-extrabold leading-[1.08] tracking-tight sm:text-7xl">
      Construyo cosas<br /><span class="text-gradient">y las comparto.</span>
    </h1>
    <div class="reveal relative mt-6 max-w-xl space-y-3 text-lg text-muted">
      <p>Desarrollo apps Android para resolver mis propias necesidades y las dejo aquí para que las uses gratis.</p>
      <p>Además, cuento lo que voy haciendo.</p>
      <!-- TEXTO PROVISIONAL: sustituir por a qué te dedicas exactamente -->
      <p>En el día a día me dedico al desarrollo de software.</p>
    </div>
    <div class="reveal relative mt-8 flex flex-wrap gap-3">
      <a href="/apps/" class="rounded-full bg-accent px-6 py-3 font-semibold text-on-accent shadow-lg shadow-accent/30 transition hover:-translate-y-0.5 hover:shadow-xl">Ver mis apps</a>
      <a href="https://instagram.com/riaal.04" rel="noopener" class="btn-outline rounded-full px-6 py-3 font-semibold">📸 @riaal.04</a>
    </div>
  </section>

  <section class="grid gap-3 sm:grid-cols-3" aria-label="Qué encontrarás">
    <div class="card rounded-2xl border border-line shadow-xl shadow-fg/10 p-5"><p class="text-3xl">📱</p><h2 class="mt-3 font-bold">Apps Android</h2><p class="mt-1 text-sm text-muted">Descarga directa del APK, sin tiendas de por medio.</p></div>
    <div class="card rounded-2xl border border-line shadow-xl shadow-fg/10 p-5"><p class="text-3xl">📖</p><h2 class="mt-3 font-bold">Manual en cada app</h2><p class="mt-1 text-sm text-muted">Funciones explicadas paso a paso, con capturas.</p></div>
    <div class="card rounded-2xl border border-line shadow-xl shadow-fg/10 p-5"><p class="text-3xl">💡</p><h2 class="mt-3 font-bold">Tus ideas cuentan</h2><p class="mt-1 text-sm text-muted">Propón mejoras y apps que te gustaría ver.</p></div>
  </section>

  {enlaces.length > 0 && (
    <section class="mt-12" aria-label="Enlaces">
      <h2 class="text-xl font-bold tracking-tight sm:text-2xl">Encuéntrame en</h2>
      <ul class="mt-5 grid grid-cols-2 gap-3 sm:grid-cols-4">
        {enlaces.map((l) => (
          <li>
            {l.url ? (
              <a href={l.url} rel="noopener" class="btn-outline flex items-center gap-3 rounded-2xl px-4 py-3">
                <span class="text-2xl" aria-hidden="true">{l.icon}</span>
                <span class="min-w-0"><span class="block font-semibold">{l.name}</span>{l.handle && <span class="block truncate text-xs text-muted">{l.handle}</span>}</span>
              </a>
            ) : (
              <div class="card flex items-center gap-3 rounded-2xl border border-line px-4 py-3">
                <span class="text-2xl" aria-hidden="true">{l.icon}</span>
                <span class="min-w-0"><span class="block font-semibold">{l.name}</span><span class="block truncate text-xs text-muted select-all">{l.handle}</span></span>
              </div>
            )}
          </li>
        ))}
      </ul>
    </section>
  )}
</Base>
