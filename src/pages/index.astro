---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
const posts = (await getCollection('insta')).sort((a, b) => +b.data.date - +a.data.date);
const fmt = (d: Date) => d.toLocaleDateString('es-ES', { day: 'numeric', month: 'short', year: 'numeric' });
---
<Base title="riaal.04 · Sobre mí" description="Desarrollo apps Android a mano, las comparto para descargar y cuento lo que hago.">
  <section class="py-14 sm:py-24">
    <p class="reveal text-sm font-medium uppercase tracking-widest text-accent">Hola, soy Rial</p>
    <h1 class="reveal mt-4 text-[2.5rem] font-extrabold leading-[1.08] tracking-tight sm:text-7xl">
      Construyo cosas<br /><span class="text-gradient">y las comparto.</span>
    </h1>
    <p class="reveal mt-6 max-w-xl text-lg text-muted">
      <!-- TEXTO PROVISIONAL: sustituir por tu presentación -->
      Desarrollo apps Android para resolver mis propias necesidades y las dejo aquí para que las uses gratis. También cuento lo que voy haciendo, y pronto, las rutas en moto.
    </p>
    <div class="reveal mt-8 flex flex-wrap gap-3">
      <a href="/apps/" class="rounded-full bg-accent px-6 py-3 font-semibold text-on-accent">Ver mis apps</a>
      <a href="https://instagram.com/riaal.04" rel="noopener" class="rounded-full border border-line px-6 py-3 font-semibold">@riaal.04</a>
    </div>
  </section>

  <section class="grid gap-3 sm:grid-cols-3" aria-label="Qué encontrarás">
    <div class="card rounded-2xl border border-line p-5"><p class="text-3xl">📱</p><h2 class="mt-3 font-bold">Apps Android</h2><p class="mt-1 text-sm text-muted">Descarga directa del APK, sin tiendas de por medio.</p></div>
    <div class="card rounded-2xl border border-line p-5"><p class="text-3xl">📖</p><h2 class="mt-3 font-bold">Manual en cada app</h2><p class="mt-1 text-sm text-muted">Funciones explicadas paso a paso, con capturas.</p></div>
    <div class="card rounded-2xl border border-line p-5"><p class="text-3xl">🏍️</p><h2 class="mt-3 font-bold">Bitácora de moto</h2><p class="mt-1 text-sm text-muted">Próximamente: rutas y experiencias sobre dos ruedas.</p></div>
  </section>

  <section class="py-8 mt-8">
    <div class="flex items-end justify-between">
      <h2 class="text-2xl font-bold tracking-tight">Últimas publicaciones</h2>
      <a href="https://instagram.com/riaal.04" rel="noopener" class="text-sm text-muted hover:text-fg">Ver en Instagram →</a>
    </div>
    {posts.length ? (
      <ul class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-3">
        {posts.map((p) => (
          <li>
            <a href={p.data.url} rel="noopener" class="group block overflow-hidden rounded-2xl border border-line bg-surface">
              <div class="aspect-square bg-bg">
                {p.data.image && <img src={p.data.image} alt={p.data.caption} loading="lazy" class="h-full w-full object-cover transition group-hover:scale-105" />}
              </div>
              <div class="p-3">
                <p class="line-clamp-2 text-sm">{p.data.caption}</p>
                <p class="mt-1 text-xs text-muted">{fmt(p.data.date)}</p>
              </div>
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p class="mt-6 rounded-2xl border border-dashed border-line p-6 text-muted">Aún no hay publicaciones aquí. Se añaden con un archivo por post en <code>src/content/insta</code>.</p>
    )}
  </section>
</Base>
