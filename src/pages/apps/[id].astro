---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Mejoras from '../../components/Mejoras.astro';
import PhoneShot from '../../components/PhoneShot.astro';
import { latestApk } from '../../lib/release';

export async function getStaticPaths() {
  return (await getCollection('apps')).map((app) => ({ params: { id: app.id }, props: { app } }));
}
const { app } = Astro.props;
const { Content } = await render(app);
const d = app.data;
const rel = await latestApk(d.releasesRepo, d.apkPrefix);
const mb = rel ? (rel.size / 1024 / 1024).toFixed(1) : null;
const fecha = rel ? new Date(rel.date).toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' }) : null;
---
<Base title={`${d.name} · riaal.04`} description={d.summary}>
  <article class="py-10 sm:py-16">
    <a href="/apps/" class="text-sm text-muted hover:text-fg">← Todas las apps</a>

    <header class="mt-6">
      <h1 class="text-5xl font-extrabold tracking-tight sm:text-6xl">{d.name}</h1>
      <p class="mt-2 text-xl text-accent">{d.tagline}</p>
    </header>

    <section class="mt-6 max-w-2xl space-y-4 text-lg text-muted">
      <p>{d.summary}</p>
      <div class="[&_p]:leading-relaxed"><Content /></div>
    </section>

    <section id="descarga" class="mt-8 rounded-2xl border border-line shadow-xl shadow-fg/10 bg-surface p-6">
      <h2 class="text-sm font-semibold uppercase tracking-widest text-muted">Descarga</h2>
      {rel ? (
        <div class="mt-3">
          <a href={rel.url} class="inline-block rounded-full bg-accent shadow-lg shadow-accent/30 transition hover:-translate-y-0.5 hover:shadow-xl px-7 py-3.5 text-lg font-bold text-on-accent">Descargar APK</a>
          <p class="mt-3 text-sm text-muted">Versión {rel.tag} · {mb} MB · {fecha} · {d.minAndroid}</p>
        </div>
      ) : (
        <div class="mt-3">
          <span class="inline-block rounded-full border border-line bg-white shadow-md shadow-black/8 transition hover:-translate-y-0.5 px-7 py-3.5 text-lg font-semibold text-muted">Descarga próximamente</span>
          <p class="mt-3 text-sm text-muted">{d.minAndroid}</p>
        </div>
      )}
      <details class="mt-5 text-muted">
        <summary class="cursor-pointer font-medium text-fg">Cómo instalar un APK</summary>
        <ol class="mt-3 list-decimal space-y-2 pl-5">
          <li>Descarga el archivo desde el botón.</li>
          <li>Ábrelo. Android te pedirá permitir instalar apps de este origen: acéptalo solo para tu navegador.</li>
          <li>Pulsa Instalar. Después puedes volver a desactivar ese permiso.</li>
        </ol>
      </details>
    </section>

    <section class="mt-14">
      <h2 class="text-2xl font-bold">Funcionalidades</h2>
      <ul class="mt-5 grid gap-4 sm:grid-cols-2">
        {d.features.map((f) => (
          <li class="rounded-2xl border border-line shadow-xl shadow-fg/10 bg-surface p-5">
            <h3 class="font-semibold">{f.title}</h3>
            <p class="mt-1 text-muted">{f.text}</p>
          </li>
        ))}
      </ul>
    </section>

    {d.manual.length > 0 && (
      <section id="manual" class="mt-14">
        <h2 class="text-2xl font-bold">Manual de uso</h2>
        <ol class="mt-6 space-y-10">
          {d.manual.map((step, i) => (
            <li class="grid items-center gap-6 sm:grid-cols-[11rem_1fr]">
              <PhoneShot src={step.image} alt={`Captura: ${step.title}`} />
              <div>
                <p class="text-sm font-semibold text-accent">Paso {i + 1}</p>
                <h3 class="mt-1 text-xl font-bold">{step.title}</h3>
                <p class="mt-2 text-muted">{step.text}</p>
              </div>
            </li>
          ))}
        </ol>
      </section>
    )}

    <Mejoras term={app.id} />

    {/* Futuro: donativos. Se activa añadiendo `donations` al frontmatter de la app. */}
    {d.donations && (
      <section class="mt-14 rounded-2xl border border-line shadow-xl shadow-fg/10 bg-surface p-6 text-center">
        <h2 class="text-xl font-bold">¿Te ha sido útil?</h2>
        <p class="mt-2 text-muted">{d.donations.text ?? 'Si quieres apoyar el proyecto, puedes hacer un pequeño donativo.'}</p>
        <a href={d.donations.url} rel="noopener" class="mt-4 inline-block rounded-full border border-accent shadow-md shadow-accent/20 px-6 py-2.5 font-semibold text-accent">Hacer un donativo</a>
      </section>
    )}
  </article>
</Base>
