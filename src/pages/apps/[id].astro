---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { latestApk } from '../../lib/release';

export async function getStaticPaths() {
  return (await getCollection('apps')).map((app) => ({ params: { id: app.id }, props: { app } }));
}
const { app } = Astro.props;
const { Content } = await render(app);
const d = app.data;
const rel = await latestApk(d.releasesRepo, d.apkPrefix);
const mb = rel ? (rel.size / 1024 / 1024).toFixed(1) : null;
const fecha = rel ? new Date(rel.date).toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' }) : null;
---
<Base title={`${d.name} · riaal.04`} description={d.summary}>
  <article class="py-12 sm:py-20">
    <a href="/#apps" class="text-sm text-muted hover:text-fg">← Apps</a>
    <h1 class="mt-6 text-5xl font-extrabold tracking-tight sm:text-6xl">{d.name}</h1>
    <p class="mt-2 text-xl text-accent">{d.tagline}</p>
    <p class="mt-5 max-w-2xl text-lg text-muted">{d.summary}</p>

    <div class="mt-8 rounded-2xl border border-line bg-surface p-6">
      {rel ? (
        <>
          <a href={rel.url} class="inline-block rounded-full bg-accent px-7 py-3.5 text-lg font-bold text-on-accent">Descargar APK</a>
          <p class="mt-3 text-sm text-muted">Versión {rel.tag} · {mb} MB · {fecha} · {d.minAndroid}</p>
        </>
      ) : (
        <>
          <span class="inline-block rounded-full border border-line px-7 py-3.5 text-lg font-semibold text-muted">Descarga próximamente</span>
          <p class="mt-3 text-sm text-muted">{d.minAndroid}</p>
        </>
      )}
    </div>

    <h2 class="mt-14 text-2xl font-bold">Qué hace</h2>
    <ul class="mt-5 grid gap-4 sm:grid-cols-2">
      {d.features.map((f) => (
        <li class="rounded-2xl border border-line bg-surface p-5">
          <h3 class="font-semibold">{f.title}</h3>
          <p class="mt-1 text-muted">{f.text}</p>
        </li>
      ))}
    </ul>

    <div class="mt-12 max-w-2xl text-muted [&_p]:leading-relaxed"><Content /></div>

    <h2 class="mt-14 text-2xl font-bold">Cómo instalarla</h2>
    <ol class="mt-4 max-w-2xl list-decimal space-y-2 pl-5 text-muted">
      <li>Descarga el APK desde el botón de arriba.</li>
      <li>Ábrelo. Android te pedirá permitir instalar apps de este origen: acéptalo solo para tu navegador.</li>
      <li>Pulsa Instalar. Puedes volver a desactivar el permiso después.</li>
    </ol>
  </article>
</Base>
