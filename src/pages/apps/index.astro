---
import { getCollection } from 'astro:content';
import Mejoras from '../../components/Mejoras.astro';
import Icon from '../../components/Icon.astro';
import Base from '../../layouts/Base.astro';
const apps = (await getCollection('apps')).sort((a, b) => a.data.order - b.data.order);
---
<Base title="Apps · riaal.04" description="Mis aplicaciones Android: descarga, descripción y manual de uso.">
  <section class="py-12 sm:py-16">
    <h1 class="text-4xl font-extrabold tracking-tight sm:text-5xl">Apps</h1>
    <p class="mt-3 max-w-xl text-muted">Elige una para ver qué hace, descargarla y leer su manual de uso.</p>
    <div class="mt-8 grid gap-4 sm:grid-cols-2">
      {apps.map((app) => (
        <a href={`/apps/${app.id}/`} data-app={app.id} class="lift group flex flex-col overflow-hidden rounded-3xl border border-line bg-surface text-fg shadow-xl shadow-fg/10">
          <div class="flex items-center gap-4 p-6 pb-0">
            {app.data.icon && <img src={app.data.icon} alt="" width="64" height="64" class="h-16 w-16 shrink-0 rounded-2xl shadow-lg shadow-fg/20" style={`view-transition-name: icono-${app.id}`} />}
            <div class="min-w-0">
              <p class="text-xs font-semibold uppercase tracking-widest text-muted">Android</p>
              <h2 class="text-3xl font-extrabold">{app.data.name}</h2>
            </div>
          </div>
          <p class="mt-3 px-6 font-medium text-accent">{app.data.tagline}</p>
          <p class="mt-2 px-6 text-muted">{app.data.summary}</p>
          <div class="mt-5 flex items-end justify-between gap-3 px-6 pb-0">
            <p class="pb-5 text-sm font-semibold">Ver ficha <span class="inline-block transition-transform group-hover:translate-x-1" aria-hidden="true">→</span></p>
            <div class="flex items-end gap-2">
              {app.data.manual.filter((m) => m.images[0]).slice(0, 2).map((m, i) => (
                <div class:list={['w-20 overflow-hidden rounded-t-xl border-4 border-b-0 border-fg/80 transition-transform duration-300 group-hover:-translate-y-1', i === 1 && 'translate-y-3 group-hover:translate-y-1']}>
                  <img src={m.images[0]} alt="" width="720" height="1596" loading="lazy" decoding="async" class="block h-auto w-full" />
                </div>
              ))}
            </div>
          </div>
        </a>
      ))}
      <div class="flex flex-col justify-center rounded-3xl border border-dashed border-line p-6 text-muted">
        <p class="text-xs font-semibold uppercase tracking-widest">Siguiente</p>
        <h2 class="mt-2 text-xl font-bold text-fg">Más apps en camino</h2>
        <p class="mt-2">Iré añadiendo aquí las que vaya terminando. ¿Tienes una idea? Déjala en Sugerencias, más abajo.</p>
        <a href="#mejoras" class="link-sub mt-2 w-fit font-semibold text-accent"><span>Ir a Sugerencias</span></a>
      </div>
    </div>
  </section>

  <section class="grid gap-4 pb-4 sm:grid-cols-2" aria-label="Plataformas">
    <div class="card rounded-2xl border border-line shadow-xl shadow-fg/10 p-6">
      <span class="grid h-11 w-11 place-items-center rounded-xl bg-accent/12 text-accent"><Icon name="apple" /></span>
      <h2 class="mt-3 text-xl font-bold">También hago apps para iOS</h2>
      <p class="mt-2 text-muted">Desarrollo también para iPhone. Al ser un desarrollo de mayor complejidad, es probable que las apps de iOS requieran una aportación de pago. Se indicará en la ficha de cada una.</p>
    </div>
    <div class="card rounded-2xl border border-line shadow-xl shadow-fg/10 p-6">
      <span class="grid h-11 w-11 place-items-center rounded-xl bg-accent/12 text-accent"><Icon name="monitor-smartphone" /></span>
      <h2 class="mt-3 text-xl font-bold">Hacia el multiplataforma</h2>
      <p class="mt-2 text-muted">Las apps que hoy solo están en Android se migrarán más adelante a un lenguaje multiplataforma, para usar la misma app tanto en Android como en iOS.</p>
    </div>
  </section>

  <Mejoras term="sugerencias-apps" title="Sugerencias" intro="¿Qué app te gustaría ver? ¿Qué mejorarías de las existentes? Deja aquí tus ideas y propuestas." />
</Base>
