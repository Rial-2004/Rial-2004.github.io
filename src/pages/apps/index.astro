---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
const apps = (await getCollection('apps')).sort((a, b) => a.data.order - b.data.order);
---
<Base title="Apps · riaal.04" description="Mis aplicaciones Android: descarga, descripción y manual de uso.">
  <section class="py-12 sm:py-16">
    <h1 class="text-4xl font-extrabold tracking-tight sm:text-5xl">Apps</h1>
    <p class="mt-3 max-w-xl text-muted">Elige una para ver qué hace, descargarla y leer su manual de uso.</p>
    <div class="mt-8 grid gap-4 sm:grid-cols-2">
      {apps.map((app) => (
        <a href={`/apps/${app.id}/`} class="group rounded-2xl card border border-line p-6 transition hover:-translate-y-0.5 hover:border-accent">
          <p class="text-xs uppercase tracking-widest text-muted">Android</p>
          <h2 class="mt-2 text-2xl font-bold">{app.data.name}</h2>
          <p class="mt-1 text-accent">{app.data.tagline}</p>
          <p class="mt-3 text-muted">{app.data.summary}</p>
          <p class="mt-5 text-sm font-semibold group-hover:text-accent">Ver ficha →</p>
        </a>
      ))}
      <div class="rounded-2xl border border-dashed border-line p-6 text-muted">
        <h2 class="text-lg font-semibold text-fg">Más apps en camino</h2>
        <p class="mt-2">Iré añadiendo aquí las que vaya terminando.</p>
      </div>
    </div>
  </section>
</Base>
