---
// Iconos de Lucide (ISC). Se incrustan como SVG en línea y heredan el color del texto.
interface Props { name: 'smartphone' | 'book-open' | 'lightbulb' | 'sun' | 'moon'; class?: string }
const { name, class: cls = 'h-6 w-6' } = Astro.props;
const files = import.meta.glob('/node_modules/lucide-static/icons/*.svg', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;
const raw = files[`/node_modules/lucide-static/icons/${name}.svg`] ?? '';
const svg = raw
  .replace(/<!--[\s\S]*?-->/, '')
  .replace(/<svg[^>]*>/, (tag) =>
    tag.replace(/\s(width|height)="[^"]*"/g, '').replace(/class="[^"]*"/, `class="${cls}" aria-hidden="true"`));
---
<Fragment set:html={svg} />
