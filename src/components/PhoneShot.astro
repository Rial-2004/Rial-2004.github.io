---
interface Props { src?: string; alt: string }
const { src, alt } = Astro.props;
---
<div class="mx-auto w-36 shrink-0 rounded-[2rem] border-4 border-fg/80 bg-fg/80 p-1 shadow-xl sm:w-44">
  <div class="aspect-[9/19] overflow-hidden rounded-[1.5rem] bg-gradient-to-b from-surface to-line">
    {src
      ? <img src={src} alt={alt} loading="lazy" class="h-full w-full object-cover" />
      : <div class="flex h-full items-center justify-center p-4 text-center text-xs text-muted">Captura pendiente</div>}
  </div>
</div>
