---
// Comentarios de usuarios (opiniones, propuestas, sugerencias) sobre GitHub Discussions vía giscus.
import { giscus } from '../lib/giscus';
interface Props { term: string; title?: string; intro?: string }
const {
  term,
  title = 'Mejoras y opiniones',
  intro = '¿Algo que no te gusta, un fallo o una idea para la próxima versión? Cuéntalo aquí abajo.',
} = Astro.props;
---
<section id="mejoras" class="mt-14">
  <h2 class="text-2xl font-bold">{title}</h2>
  <p class="mt-2 max-w-2xl text-muted">{intro}</p>
  {giscus ? (
    <>
      <div class="giscus mt-6"></div>
      <script is:inline
        src="https://giscus.app/client.js"
        data-repo={giscus.repo} data-repo-id={giscus.repoId}
        data-category={giscus.category} data-category-id={giscus.categoryId}
        data-mapping="specific" data-term={term} data-strict="1"
        data-reactions-enabled="1" data-emit-metadata="0" data-input-position="top"
        data-theme="preferred_color_scheme" data-lang="es" data-loading="lazy" crossorigin="anonymous" async></script>
    </>
  ) : (
    <p class="mt-6 rounded-2xl border border-dashed border-line p-6 text-muted">Este espacio se activará muy pronto.</p>
  )}
</section>
