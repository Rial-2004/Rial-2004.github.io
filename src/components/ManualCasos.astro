---
// Manual de uso en rejilla: tarjetas por caso de uso, filtro por categoría y visor ampliado (con pasos y capturas).
// Sin JavaScript todas las tarjetas se ven y cada una enlaza a su captura; con JavaScript se abre el visor.
export interface Caso {
  categoria: string;
  title: string;
  summary: string;
  steps: string[];
  images: string[];
  note?: string;
}
interface Props { casos: Caso[]; appName: string }
const { casos, appName } = Astro.props;

const CATEGORIAS: Record<string, string> = {
  entrenar: 'Entrenar',
  rutinas: 'Rutinas y semana',
  progreso: 'Progreso',
  comunidad: 'Comunidad',
  perfil: 'Perfil y ajustes',
  widgets: 'Widgets',
  actualizar: 'Actualizar',
};
const usadas = Object.keys(CATEGORIAS).filter((c) => casos.some((k) => k.categoria === c));
const slug = (t: string) =>
  t.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const datos = casos.map((c) => ({
  id: slug(c.title),
  categoria: CATEGORIAS[c.categoria] ?? c.categoria,
  title: c.title,
  summary: c.summary,
  steps: c.steps,
  images: c.images,
  note: c.note ?? '',
}));
---
<section id="manual" class="mt-14" data-manual>
  <h2 class="text-2xl font-bold">Manual de uso</h2>
  <p class="mt-2 max-w-2xl text-muted">
    Todo lo que se puede hacer en {appName}, por casos de uso. Toca una tarjeta para verla ampliada, con los pasos.
  </p>

  <div class="mt-5 flex flex-wrap items-center gap-2" role="group" aria-label="Filtrar por categoría" data-filtros hidden>
    <button type="button" data-cat="todo" aria-pressed="true" class="chip">Todo</button>
    {usadas.map((c) => <button type="button" data-cat={c} aria-pressed="false" class="chip">{CATEGORIAS[c]}</button>)}
    <span class="ml-auto text-sm text-muted" data-contador aria-live="polite"></span>
  </div>

  <ul class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" data-rejilla>
    {casos.map((c, i) => (
      <li data-cat={c.categoria} data-i={i}>
        <a href={c.images[0] ?? `#caso-${datos[i].id}`} id={`caso-${datos[i].id}`} data-abrir
           class="group flex h-full flex-col overflow-hidden rounded-2xl card border border-line shadow-xl shadow-fg/10 transition hover:-translate-y-0.5 hover:border-accent">
          <div class="relative h-44 overflow-hidden bg-gradient-to-b from-surface to-line/60 pt-4 sm:h-48">
            {c.images[0]
              ? <div class="mx-auto w-[62%] overflow-hidden rounded-t-[1.4rem] border-4 border-b-0 border-fg/80 shadow-lg transition group-hover:-translate-y-0.5">
                  <img src={c.images[0]} alt="" loading="lazy" decoding="async" width="720" height="1596" class="block h-auto w-full" />
                </div>
              : <div class="grid h-full place-items-center text-xs text-muted">Captura pendiente</div>}
            {c.images.length > 1 && (
              <span class="absolute right-2 top-2 rounded-full bg-fg/80 px-2 py-0.5 text-[11px] font-semibold text-bg">{c.images.length} capturas</span>
            )}
          </div>
          <div class="flex flex-1 flex-col p-4">
            <p class="text-xs font-semibold uppercase tracking-wider text-accent">{CATEGORIAS[c.categoria] ?? c.categoria}</p>
            <h3 class="mt-1 text-lg font-bold leading-snug">{c.title}</h3>
            <p class="mt-1 text-sm text-muted">{c.summary}</p>
            <p class="mt-auto pt-3 text-sm font-semibold text-accent">Ver pasos →</p>
          </div>
        </a>
      </li>
    ))}
  </ul>

  <dialog id="caso-visor" aria-labelledby="visor-titulo" class="visor">
    <div class="visor-caja">
      <button type="button" data-cerrar aria-label="Cerrar" class="visor-x">×</button>
      <div class="visor-img">
        <button type="button" data-zoom aria-label="Ampliar la captura" class="visor-zoom">
          <img alt="" data-img />
        </button>
        <div class="visor-miniaturas" data-miniaturas></div>
        <p class="visor-ayuda" data-ayuda>Toca la captura para ampliarla</p>
      </div>
      <div class="visor-txt">
        <p class="text-xs font-semibold uppercase tracking-wider text-accent" data-cat></p>
        <h3 id="visor-titulo" class="mt-1 text-2xl font-bold leading-tight" data-titulo></h3>
        <p class="mt-2 text-muted" data-resumen></p>
        <ol class="mt-4 list-decimal space-y-2 pl-5" data-pasos></ol>
        <p class="mt-4 rounded-xl border border-line bg-bg/60 p-3 text-sm text-muted" data-nota hidden></p>
        <div class="visor-nav">
          <button type="button" data-ant class="btn-outline rounded-full px-4 py-2 text-sm font-semibold">← Anterior</button>
          <span class="text-sm text-muted" data-pos></span>
          <button type="button" data-sig class="btn-outline rounded-full px-4 py-2 text-sm font-semibold">Siguiente →</button>
        </div>
      </div>
    </div>
  </dialog>

  <script type="application/json" id="manual-datos" set:html={JSON.stringify(datos)} />
</section>

<style>
  .chip {
    border-radius: 9999px; padding: 0.4rem 0.95rem; font-size: 0.875rem; font-weight: 600;
    border: 1px solid var(--color-line); background: var(--color-surface); color: var(--color-muted);
    transition: background .15s, color .15s, border-color .15s;
  }
  .chip:hover { color: var(--color-fg); border-color: var(--color-accent); }
  .chip[aria-pressed="true"] { background: var(--color-accent); border-color: var(--color-accent); color: var(--color-on-accent); }

  .visor {
    padding: 0; border: 0; background: transparent; color: var(--color-fg);
    width: min(62rem, calc(100vw - 1.5rem)); max-width: none; max-height: calc(100dvh - 1.5rem);
    margin: auto; overflow: visible;
  }
  .visor::backdrop { background: rgb(8 14 24 / 0.72); backdrop-filter: blur(4px); }
  .visor-caja {
    position: relative; display: grid; grid-template-columns: minmax(0, 20rem) minmax(0, 1fr); gap: 0;
    max-height: calc(100dvh - 1.5rem); overflow: auto;
    border-radius: 1.5rem; border: 1px solid var(--color-line); background: var(--color-surface);
    box-shadow: 0 30px 80px -20px rgb(0 0 0 / 0.6);
  }
  .visor-img {
    display: flex; flex-direction: column; align-items: center; gap: 0.75rem; padding: 1.25rem 1rem;
    background: linear-gradient(180deg, color-mix(in oklab, var(--color-line) 45%, var(--color-surface)), var(--color-surface));
  }
  .visor-zoom { cursor: zoom-in; display: block; border-radius: 1.5rem; }
  .visor-zoom img {
    display: block; width: auto; max-width: 100%; max-height: min(74dvh, 40rem);
    border-radius: 1.4rem; border: 4px solid color-mix(in oklab, var(--color-fg) 80%, transparent);
    box-shadow: 0 18px 40px -12px rgb(0 0 0 / 0.45);
  }
  .visor-miniaturas { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.4rem; }
  .visor-miniaturas button {
    width: 2.6rem; height: 0.5rem; border-radius: 9999px; background: var(--color-line);
    transition: background .15s, width .15s;
  }
  .visor-miniaturas button[aria-current="true"] { background: var(--color-accent); width: 3.4rem; }
  .visor-ayuda { font-size: 0.75rem; color: var(--color-muted); }
  .visor-txt { padding: 1.75rem 1.75rem 1.5rem; display: flex; flex-direction: column; }
  .visor-nav {
    display: flex; align-items: center; justify-content: space-between; gap: 0.5rem;
    margin-top: auto; padding-top: 1.5rem;
  }
  .visor-x {
    position: absolute; right: 0.6rem; top: 0.5rem; z-index: 2; width: 2.5rem; height: 2.5rem; border-radius: 9999px;
    font-size: 1.75rem; line-height: 1; color: var(--color-fg);
    background: color-mix(in oklab, var(--color-surface) 85%, transparent); border: 1px solid var(--color-line);
  }
  .visor-x:hover { border-color: var(--color-accent); }

  /* Casos sin captura: solo texto, en una columna. */
  .visor[data-sin-img] .visor-caja { grid-template-columns: minmax(0, 1fr); }
  .visor[data-sin-img] .visor-img { display: none; }

  /* Zoom: la captura ocupa todo el visor a tamaño real y se desplaza; se vuelve a tocar para salir. */
  .visor[data-zoom] .visor-caja { grid-template-columns: minmax(0, 1fr); }
  .visor[data-zoom] .visor-txt { display: none; }
  .visor[data-zoom] .visor-zoom { cursor: zoom-out; }
  .visor[data-zoom] .visor-zoom img { width: min(100%, 45rem); max-width: none; max-height: none; }

  @media (max-width: 47.99rem) {
    .visor { width: 100vw; max-height: 100dvh; }
    .visor-caja { grid-template-columns: minmax(0, 1fr); border-radius: 1.25rem 1.25rem 0 0; max-height: 100dvh; }
    .visor-zoom img { max-height: min(52dvh, 28rem); }
    .visor-txt { padding: 1.25rem 1.25rem 1.5rem; }
  }
</style>

<script>
  type Dato = { id: string; categoria: string; title: string; summary: string; steps: string[]; images: string[]; note: string };

  const raiz = document.querySelector<HTMLElement>('[data-manual]');
  if (raiz) {
    const datos: Dato[] = JSON.parse(document.getElementById('manual-datos')!.textContent || '[]');
    const dialog = raiz.querySelector<HTMLDialogElement>('#caso-visor')!;
    const q = <T extends HTMLElement>(s: string) => dialog.querySelector<T>(s)!;
    const img = q<HTMLImageElement>('[data-img]');
    const miniaturas = q('[data-miniaturas]');
    const items = Array.from(raiz.querySelectorAll<HTMLLIElement>('[data-rejilla] > li'));
    const filtros = raiz.querySelector<HTMLElement>('[data-filtros]')!;
    const contador = raiz.querySelector<HTMLElement>('[data-contador]')!;

    let actual = 0;
    let foto = 0;
    const visibles = () => items.filter((li) => !li.hidden).map((li) => Number(li.dataset.i));

    // --- Filtros por categoría ---
    filtros.hidden = false;
    const filtrar = (cat: string) => {
      filtros.querySelectorAll<HTMLElement>('button[data-cat]').forEach((b) =>
        b.setAttribute('aria-pressed', String(b.dataset.cat === cat)));
      let n = 0;
      items.forEach((li) => {
        const ok = cat === 'todo' || li.dataset.cat === cat;
        li.hidden = !ok;
        if (ok) n++;
      });
      contador.textContent = `${n} ${n === 1 ? 'caso' : 'casos'}`;
    };
    filtros.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLElement>('button[data-cat]');
      if (b) filtrar(b.dataset.cat!);
    });
    filtrar('todo');

    // --- Visor ---
    const pintarFoto = () => {
      const d = datos[actual];
      img.src = d.images[foto] ?? '';
      img.alt = `Captura ${foto + 1} de ${d.images.length}: ${d.title}`;
      miniaturas.innerHTML = '';
      if (d.images.length > 1) {
        d.images.forEach((_, i) => {
          const b = document.createElement('button');
          b.type = 'button';
          b.setAttribute('aria-label', `Ver la captura ${i + 1}`);
          if (i === foto) b.setAttribute('aria-current', 'true');
          b.addEventListener('click', () => { foto = i; pintarFoto(); });
          miniaturas.appendChild(b);
        });
      }
    };
    const pintar = () => {
      const d = datos[actual];
      q('[data-cat]').textContent = d.categoria;
      q('[data-titulo]').textContent = d.title;
      q('[data-resumen]').textContent = d.summary;
      const pasos = q('[data-pasos]');
      pasos.innerHTML = '';
      d.steps.forEach((s) => { const li = document.createElement('li'); li.textContent = s; pasos.appendChild(li); });
      pasos.hidden = d.steps.length === 0;
      const nota = q('[data-nota]');
      nota.textContent = d.note;
      nota.hidden = !d.note;
      const v = visibles();
      q('[data-pos]').textContent = `${Math.max(v.indexOf(actual), 0) + 1} / ${v.length}`;
      q('[data-ayuda]').hidden = d.images.length === 0;
      if (d.images.length === 0) dialog.setAttribute('data-sin-img', ''); else dialog.removeAttribute('data-sin-img');
      foto = 0;
      pintarFoto();
      dialog.querySelector('.visor-caja')!.scrollTop = 0;
    };
    const abrir = (i: number) => {
      actual = i;
      dialog.removeAttribute('data-zoom');
      pintar();
      if (!dialog.open) dialog.showModal();
      history.replaceState(null, '', `#caso-${datos[i].id}`);
    };
    const mover = (delta: number) => {
      const v = visibles();
      if (v.length === 0) return;
      const pos = (v.indexOf(actual) + delta + v.length) % v.length;
      dialog.removeAttribute('data-zoom');
      actual = v[pos];
      pintar();
      history.replaceState(null, '', `#caso-${datos[actual].id}`);
    };

    raiz.querySelector('[data-rejilla]')!.addEventListener('click', (e) => {
      const a = (e.target as HTMLElement).closest<HTMLElement>('[data-abrir]');
      if (!a) return;
      // Con clic normal se abre el visor; con Ctrl/Cmd o botón central se deja abrir la imagen en otra pestaña.
      const ev = e as MouseEvent;
      if (ev.ctrlKey || ev.metaKey || ev.shiftKey || ev.button === 1) return;
      e.preventDefault();
      abrir(Number(a.closest<HTMLElement>('li')!.dataset.i));
    });
    q('[data-cerrar]').addEventListener('click', () => dialog.close());
    q('[data-ant]').addEventListener('click', () => mover(-1));
    q('[data-sig]').addEventListener('click', () => mover(1));
    q('[data-zoom]').addEventListener('click', () => {
      if (dialog.hasAttribute('data-zoom')) dialog.removeAttribute('data-zoom'); else dialog.setAttribute('data-zoom', '');
      q('[data-zoom]').setAttribute('aria-label', dialog.hasAttribute('data-zoom') ? 'Volver al tamaño normal' : 'Ampliar la captura');
    });
    // Clic en el fondo oscuro = cerrar.
    dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
    dialog.addEventListener('close', () => {
      dialog.removeAttribute('data-zoom');
      if (location.hash.startsWith('#caso-')) history.replaceState(null, '', location.pathname + location.search + '#manual');
    });
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') { e.preventDefault(); mover(-1); }
      if (e.key === 'ArrowRight') { e.preventDefault(); mover(1); }
    });

    // Enlace directo a un caso (#caso-<id>): se abre al cargar.
    const enlazado = datos.findIndex((d) => location.hash === `#caso-${d.id}`);
    if (enlazado >= 0) { filtrar('todo'); abrir(enlazado); }
  }
</script>
