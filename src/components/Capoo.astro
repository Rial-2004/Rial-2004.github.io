---
// Capoo dibujado a mano en SVG como homenaje de fan (no son imágenes oficiales).
interface Props { mood?: 'happy' | 'sleepy' | 'love' | 'chick' | 'wow'; class?: string }
const { mood = 'happy', class: cls = '' } = Astro.props;
const id = `c${Math.random().toString(36).slice(2, 7)}`;
---
<svg class={cls} viewBox="0 0 140 110" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
  <g stroke="#1b79ad" stroke-width="3" stroke-linejoin="round" stroke-linecap="round">
    <!-- patas -->
    <ellipse cx="38" cy="98" rx="11" ry="7" fill="#46bde8" />
    <ellipse cx="70" cy="101" rx="11" ry="7" fill="#46bde8" />
    <ellipse cx="102" cy="98" rx="11" ry="7" fill="#46bde8" />
    <!-- orejas -->
    <path d="M26 40 L30 12 L52 28 Z" fill="#46bde8" />
    <path d="M114 40 L110 12 L88 28 Z" fill="#46bde8" />
    <!-- cuerpo -->
    <ellipse cx="70" cy="60" rx="52" ry="40" fill="#46bde8" />
    <!-- barriga -->
    <ellipse cx="70" cy="80" rx="27" ry="17" fill="#eaf8ff" stroke="none" />
  </g>
  <!-- mejillas -->
  <ellipse cx="36" cy="66" rx="7" ry="4.5" fill="#ff9db0" opacity=".85" />
  <ellipse cx="104" cy="66" rx="7" ry="4.5" fill="#ff9db0" opacity=".85" />
  {mood === 'sleepy' ? (
    <>
      <path d="M36 55 Q44 62 52 55" stroke="#0e2230" stroke-width="3.5" fill="none" stroke-linecap="round" />
      <path d="M88 55 Q96 62 104 55" stroke="#0e2230" stroke-width="3.5" fill="none" stroke-linecap="round" />
      <path d="M64 66 Q70 70 76 66" stroke="#0e2230" stroke-width="3" fill="none" stroke-linecap="round" />
      <text x="112" y="26" font-family="Arial, sans-serif" font-weight="700" font-size="16" fill="#1b79ad">z</text>
      <text x="124" y="14" font-family="Arial, sans-serif" font-weight="700" font-size="11" fill="#1b79ad">z</text>
    </>
  ) : (
    <>
      <ellipse cx="46" cy="54" rx="5.5" ry="8" fill="#0e2230" />
      <ellipse cx="94" cy="54" rx="5.5" ry="8" fill="#0e2230" />
      <circle cx="47.5" cy="51" r="1.8" fill="#fff" />
      <circle cx="95.5" cy="51" r="1.8" fill="#fff" />
      {mood === 'wow'
        ? <ellipse cx="70" cy="68" rx="5" ry="6" fill="#0e2230" />
        : mood === 'happy' || mood === 'chick' || mood === 'love'
          ? <path d="M60 64 Q70 76 80 64 Z" fill="#0e2230" stroke="#0e2230" stroke-width="2" stroke-linejoin="round" />
          : null}
    </>
  )}
  {mood === 'love' && (
    <>
      <path d="M14 30 c-5 -7 -14 0 -8 8 l8 8 l8 -8 c6 -8 -3 -15 -8 -8 z" fill="#ff6f8d" />
      <path d="M122 18 c-4 -6 -11 0 -6 6 l6 6 l6 -6 c5 -6 -2 -12 -6 -6 z" fill="#ff6f8d" />
    </>
  )}
  {mood === 'chick' && (
    <g transform="translate(104 78)">
      <ellipse cx="14" cy="14" rx="16" ry="14" fill="#ffd93b" stroke="#c99a00" stroke-width="2.5" />
      <circle cx="9" cy="11" r="2" fill="#0e2230" /><circle cx="19" cy="11" r="2" fill="#0e2230" />
      <path d="M11 17 L14 20 L17 17 Z" fill="#ff9a3c" />
    </g>
  )}
</svg>
